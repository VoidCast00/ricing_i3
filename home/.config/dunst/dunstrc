# dunst — Gruvbox Dark

[global]
    monitor = 0
    follow = mouse
    origin = top-right
    # sit just below the 26px polybar
    offset = (12, 38)
    width = 340
    height = (0, 300)
    notification_limit = 5
    gap_size = 6
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    separator_color = frame
    corner_radius = 0
    font = Hack Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    ellipsize = middle
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    progress_bar = true
    progress_bar_frame_width = 1
    highlight = "#83a598"
    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = false
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#282828"
    foreground = "#a89984"
    frame_color = "#504945"
    timeout = 5

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#83a598"
    timeout = 8

[urgency_critical]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#fb4934"
    highlight = "#fb4934"
    timeout = 0
